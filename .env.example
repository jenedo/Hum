# Supabase PostgreSQL — Supavisor transaction pooler for application runtime.
# Port 6543 uses transaction mode; pgbouncer=true is required for Prisma.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# Supabase PostgreSQL — Supavisor session pooler for Prisma direct operations.
# Port 5432 uses session mode and does not set pgbouncer=true.
DIRECT_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth server configuration. Use the publishable key only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<placeholder>
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Upstash Redis — TCP connection string (redis:// or rediss:// for TLS).
REDIS_URL=rediss://default:<password>@<host>:6379

# Temporary legacy auth configuration retained until the guarded migration batch.
JWT_ACCESS_SECRET=<replace-with-at-least-32-characters>
JWT_REFRESH_SECRET=<replace-with-at-least-32-characters>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PORT=3000
NODE_ENV=development

# One-time admin seed (prisma/seed.ts via npx prisma db seed).
# Not required for app boot — only used by the seed script.
# Safe to re-run: skips if any ADMIN user already exists.
SEED_ADMIN_EMAIL=admin@asaancare.local
SEED_ADMIN_PASSWORD=<replace-before-seeding>
