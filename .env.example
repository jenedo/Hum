# Neon Postgres — pooled connection (app runtime queries go through this).
# Host typically ends in -pooler.neon.tech and includes ?sslmode=require
DATABASE_URL=postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# Neon Postgres — direct (non-pooled) connection. Prisma migrations use this
# to avoid pgbouncer/prepared-statement issues. Host has NO -pooler segment.
DIRECT_URL=postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/<db>?sslmode=require

# Upstash Redis — TCP connection string (redis:// or rediss:// for TLS).
REDIS_URL=redis://default:<password>@<endpoint>.upstash.io:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PORT=3000
NODE_ENV=development

# One-time admin seed (prisma/seed.ts via `npx prisma db seed`).
# Not required for app boot — only used by the seed script.
# Safe to re-run: skips if any ADMIN user already exists.
SEED_ADMIN_EMAIL=admin@asaancare.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin1!
