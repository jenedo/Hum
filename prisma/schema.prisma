generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                  @id @default(uuid())
  supabaseAuthUserId     String?                 @unique
  email                  String                  @unique
  mobile                 String?                 @unique
  passwordHash           String?
  role                   Role
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  auditLogs              AuditLog[]
  doctorProfile          DoctorProfile?
  reviewedVerifications  DoctorVerification[]    @relation("VerificationReviewer")
  patientProfile         PatientProfile?
  refreshTokens          RefreshToken[]
  deviceRegistrations    DeviceRegistration[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  wallet                 Wallet?
  paymentAttempts        PaymentAttempt[]
  payouts                Payout[]
}

model PatientProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  fullName          String
  dateOfBirth       DateTime?
  gender            String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  appointments      Appointment[]
  prescriptions     Prescription[]
  storedObjects     StoredObject[]
  cart              Cart[]
  deliveryAddresses DeliveryAddress[]
  pharmacyOrders    PharmacyOrder[]
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DoctorProfile {
  id             String               @id @default(uuid())
  userId         String               @unique
  fullName       String
  pmdcNumber     String               @unique
  specialty      String
  isVerified     Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  appointments   Appointment[]
  availabilities DoctorAvailability[]
  prescriptions  Prescription[]
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  verification   DoctorVerification?
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Specialty {
  id   String @id @default(uuid())
  name String @unique
}

model DoctorVerification {
  id              String             @id @default(uuid())
  doctorProfileId String             @unique
  status          VerificationStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  documents       DoctorDocument[]
  doctorProfile   DoctorProfile      @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  reviewedBy      User?              @relation("VerificationReviewer", fields: [reviewedById], references: [id])
}

model DoctorDocument {
  id                   String             @id @default(uuid())
  doctorVerificationId String
  type                 DocumentType
  storageKey           String
  uploadedAt           DateTime           @default(now())
  doctorVerification   DoctorVerification @relation(fields: [doctorVerificationId], references: [id], onDelete: Cascade)

  @@index([doctorVerificationId])
}

model DoctorAvailability {
  id                  String        @id @default(uuid())
  doctorProfileId     String
  dayOfWeek           Int
  startMinutes        Int
  endMinutes          Int
  slotDurationMinutes Int           @default(30)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  doctorProfile       DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@index([doctorProfileId, dayOfWeek])
}

model Appointment {
  id               String            @id @default(uuid())
  patientProfileId String
  doctorProfileId  String
  slotStart        DateTime
  slotEnd          DateTime
  status           AppointmentStatus @default(PENDING)
  consultationType ConsultationType
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  doctorProfile    DoctorProfile     @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  patientProfile   PatientProfile    @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  prescriptions    Prescription[]

  @@unique([doctorProfileId, slotStart])
  @@index([patientProfileId])
  @@index([doctorProfileId])
}

model Prescription {
  id               String             @id @default(uuid())
  appointmentId    String
  doctorProfileId  String
  patientProfileId String
  status           PrescriptionStatus @default(ISSUED)
  version          Int                @default(1)
  supersedesId     String?
  medicines        Json
  instructions     String?
  voidedAt         DateTime?
  voidReason       String?
  issuedAt         DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  appointment    Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  doctorProfile  DoctorProfile   @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  patientProfile PatientProfile  @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  supersedes     Prescription?   @relation("PrescriptionRevisions", fields: [supersedesId], references: [id], onDelete: Restrict)
  revisions      Prescription[]  @relation("PrescriptionRevisions")
  pharmacyOrders PharmacyOrder[]

  @@unique([appointmentId, version])
  @@index([patientProfileId])
  @@index([doctorProfileId])
}

model StoredObject {
  id               String            @id @default(uuid())
  patientProfileId String
  bucketName       String
  objectKey        String
  fileName         String
  fileSizeBytes    Int
  mimeType         String
  sha256Hash       String
  scanStatus       StorageScanStatus @default(PENDING)
  scanResultAt     DateTime?
  purpose          StoragePurpose
  createdAt        DateTime          @default(now())
  patientProfile   PatientProfile    @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@index([patientProfileId])
  @@index([purpose, scanStatus])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String
  action       String
  resourceType String
  resourceId   String
  metadataJson String?
  createdAt    DateTime @default(now())
  actorUser    User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
}

model DeviceRegistration {
  id             String                 @id @default(uuid())
  userId         String
  installationId String
  fcmToken       String
  platform       DevicePlatform
  appMode        AppMode
  appVersion     String
  enabled        Boolean                @default(true)
  lastSeenAt     DateTime               @default(now())
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  revokedAt      DateTime?
  deliveries     NotificationDelivery[]
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, installationId, appMode])
  @@unique([fcmToken])
  @@index([userId, enabled])
}

model Notification {
  id         String                 @id @default(uuid())
  userId     String
  type       NotificationType
  titleKey   String
  bodyKey    String
  entityType String?
  entityId   String?
  route      String?
  dataJson   String?
  status     NotificationStatus     @default(QUEUED)
  createdAt  DateTime               @default(now())
  sentAt     DateTime?
  deliveries NotificationDelivery[]
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([entityType, entityId])
}

model NotificationDelivery {
  id                   String             @id @default(uuid())
  notificationId       String
  deviceRegistrationId String
  status               DeliveryStatus     @default(QUEUED)
  sentAt               DateTime?
  errorMessage         String?
  deviceRegistration   DeviceRegistration @relation(fields: [deviceRegistrationId], references: [id], onDelete: Cascade)
  notification         Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([deviceRegistrationId])
}

model NotificationPreference {
  userId              String   @id
  appointmentUpdates  Boolean  @default(true)
  reminders           Boolean  @default(true)
  prescriptionUpdates Boolean  @default(true)
  pharmacyUpdates     Boolean  @default(true)
  paymentUpdates      Boolean  @default(true)
  marketing           Boolean  @default(false)
  quietHoursStart     Int?
  quietHoursEnd       Int?
  timezone            String   @default("Asia/Karachi")
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OutboxEvent {
  id            String       @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payloadJson   String
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, availableAt, attempts])
  @@index([aggregateType, aggregateId])
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  PMDC_CERTIFICATE
  CNIC_FRONT
  CNIC_BACK
  MBBS_DEGREE
  EXPERIENCE_LETTER
}

enum AppointmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  RESCHEDULE_PROPOSED
  CONFIRMED
  CANCELLED
  WAITING
  IN_PROGRESS
  COMPLETED
  NO_SHOW
}

enum ConsultationType {
  VIDEO
  AUDIO
  CHAT
}

enum PrescriptionStatus {
  ISSUED
  VOIDED
}

enum StorageScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum StoragePurpose {
  DOCTOR_VERIFICATION_DOCUMENT
  MEDICAL_RECORD
}

enum AppMode {
  PATIENT
  DOCTOR
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_ACCEPTED
  APPOINTMENT_REJECTED
  APPOINTMENT_CANCELLED
  CONSULTATION_REMINDER
  CONSULTATION_STARTED
  PRESCRIPTION_ISSUED
  PRESCRIPTION_VOIDED
  MEDICAL_RECORD_VALIDATED
  MEDICAL_RECORD_REJECTED
  PHARMACY_ORDER_PLACED
  PHARMACY_ORDER_STATUS_CHANGED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  WALLET_CREDITED
  WALLET_DEBITED
  FOLLOW_UP_MESSAGE
}

enum NotificationStatus {
  QUEUED
  SENT
  PARTIAL
  FAILED
}

enum DeliveryStatus {
  QUEUED
  SENDING
  ACCEPTED_BY_PROVIDER
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum InventoryBatchStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  QUARANTINED
  RECALLED
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RESERVATION
  RESERVATION_RELEASE
  SALE
  RETURN
  EXPIRED
  DAMAGED
  RECALLED
}

model PharmacyCategory {
  id          String            @id @default(uuid())
  name        String            @unique
  slug        String            @unique
  description String?
  imageUrl    String?
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    PharmacyProduct[]
}

model PharmacyProduct {
  id                   String                 @id @default(uuid())
  categoryId           String
  category             PharmacyCategory       @relation(fields: [categoryId], references: [id])
  sku                  String                 @unique
  genericName          String
  brandName            String
  strength             String?
  dosageForm           String
  manufacturer         String?
  packSize             Int                    @default(1)
  prescriptionRequired Boolean                @default(false)
  unitPriceMinor       Int
  currency             String                 @default("PKR")
  description          String?
  imageUrl             String?
  searchText           String
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  inventory            ProductInventory?
  cartItems            CartItem[]
  orderItems           PharmacyOrderItem[]
  reservations         InventoryReservation[]
  inventoryBatches     InventoryBatch[]
  inventoryMovements   InventoryMovement[]

  @@index([categoryId, isActive])
  @@index([isActive, brandName])
  @@index([isActive, genericName])
}

model InventoryBatch {
  id                 String               @id @default(uuid())
  productId          String
  product            PharmacyProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber        String
  expiryDate         DateTime
  quantityOnHand     Int                  @default(0)
  quantityReserved   Int                  @default(0)
  purchasePriceMinor Int?
  currency           String               @default("PKR")
  supplierReference  String?
  status             InventoryBatchStatus @default(ACTIVE)
  receivedAt         DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  movements    InventoryMovement[]
  reservations InventoryReservation[]

  @@unique([productId, batchNumber])
  @@index([productId, status, expiryDate])
  @@index([expiryDate, status])
}

model InventoryMovement {
  id            String                @id @default(uuid())
  productId     String
  product       PharmacyProduct       @relation(fields: [productId], references: [id])
  batchId       String?
  batch         InventoryBatch?       @relation(fields: [batchId], references: [id])
  type          InventoryMovementType
  quantityDelta Int
  quantityAfter Int
  referenceType String?
  referenceId   String?
  reason        String?
  actorUserId   String?
  createdAt     DateTime              @default(now())

  @@index([productId, createdAt])
  @@index([batchId, createdAt])
  @@index([referenceType, referenceId])
}

model ProductInventory {
  id               String          @id @default(uuid())
  productId        String          @unique
  product          PharmacyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOnHand   Int             @default(0)
  quantityReserved Int             @default(0)
  reorderLevel     Int             @default(10)
  updatedAt        DateTime        @updatedAt

  @@index([quantityOnHand])
  @@index([quantityReserved])
}

model Cart {
  id        String         @id @default(uuid())
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  currency  String         @default("PKR")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     CartItem[]

  @@unique([patientId, currency])
  @@index([patientId, currency])
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   PharmacyProduct @relation(fields: [productId], references: [id])
  quantity  Int
  addedAt   DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId])
}

model DeliveryAddress {
  id            String          @id @default(uuid())
  patientId     String
  patient       PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  label         String
  recipientName String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  province      String
  postalCode    String?
  isDefault     Boolean         @default(false)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  orders        PharmacyOrder[]

  @@index([patientId, deletedAt])
}

model PharmacyOrder {
  id                 String                 @id @default(uuid())
  orderNumber        String                 @unique
  patientId          String
  patient            PatientProfile         @relation(fields: [patientId], references: [id])
  deliveryAddressId  String
  deliveryAddress    DeliveryAddress        @relation(fields: [deliveryAddressId], references: [id])
  prescriptionId     String?
  prescription       Prescription?          @relation(fields: [prescriptionId], references: [id])
  status             PharmacyOrderStatus    @default(PENDING_PAYMENT)
  subtotalMinor      Int
  deliveryFeeMinor   Int                    @default(0)
  discountMinor      Int                    @default(0)
  totalMinor         Int
  currency           String                 @default("PKR")
  idempotencyKey     String                 @unique
  recipientNameSnap  String
  recipientPhoneSnap String
  addressSnap        String
  addressLine1Snap   String
  addressLine2Snap   String?
  citySnap           String
  provinceSnap       String
  postalCodeSnap     String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  items              PharmacyOrderItem[]
  statusHistory      OrderStatusHistory[]
  reservations       InventoryReservation[]
  paymentAttempts    PaymentAttempt[]

  @@index([patientId, createdAt])
  @@index([patientId, status])
  @@index([status, createdAt])
}

model PharmacyOrderItem {
  id                       String          @id @default(uuid())
  orderId                  String
  order                    PharmacyOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId                String
  product                  PharmacyProduct @relation(fields: [productId], references: [id])
  skuSnap                  String
  productNameSnap          String
  brandNameSnap            String
  genericNameSnap          String
  strengthSnap             String?
  dosageFormSnap           String
  prescriptionRequiredSnap Boolean
  unitPriceSnap            Int
  quantity                 Int
  lineTotalMinor           Int
  createdAt                DateTime        @default(now())
}

model InventoryReservation {
  id         String            @id @default(uuid())
  orderId    String
  order      PharmacyOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    PharmacyProduct   @relation(fields: [productId], references: [id])
  batchId    String?
  batch      InventoryBatch?   @relation(fields: [batchId], references: [id])
  quantity   Int
  status     ReservationStatus @default(HELD)
  expiresAt  DateTime
  releasedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([status, expiresAt])
  @@index([orderId])
  @@index([productId])
  @@index([batchId])
}

model OrderStatusHistory {
  id         String               @id @default(uuid())
  orderId    String
  order      PharmacyOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus PharmacyOrderStatus?
  toStatus   PharmacyOrderStatus
  changedBy  String?
  note       String?
  createdAt  DateTime             @default(now())

  @@index([orderId, createdAt])
}

enum PharmacyOrderStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  CONFIRMED
  PREPARING
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  PAYMENT_FAILED
}

enum ReservationStatus {
  HELD
  CONSUMED
  RELEASED
  EXPIRED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum PaymentProvider {
  SANDBOX
  JAZZCASH
  EASYPAISA
}

enum PaymentStatus {
  CREATED
  PENDING
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model Wallet {
  id            String              @id @default(uuid())
  userId        String              @unique
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency      String              @default("PKR")
  balanceMinor  Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  ledgerEntries WalletLedgerEntry[]
}

model WalletLedgerEntry {
  id            String          @id @default(uuid())
  walletId      String
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  type          LedgerEntryType
  amountMinor   Int
  currency      String          @default("PKR")
  balanceAfter  Int
  description   String
  referenceType String?
  referenceId   String?
  createdAt     DateTime        @default(now())

  @@index([walletId, createdAt])
}

model PaymentAttempt {
  id               String                @id @default(uuid())
  orderId          String?
  pharmacyOrder    PharmacyOrder?        @relation(fields: [orderId], references: [id])
  userId           String
  user             User                  @relation(fields: [userId], references: [id])
  provider         PaymentProvider
  status           PaymentStatus         @default(CREATED)
  amountMinor      Int
  currency         String                @default("PKR")
  providerRef      String?
  providerResponse String?
  idempotencyKey   String                @unique
  failureReason    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  webhookEvents    PaymentWebhookEvent[]
  refunds          Refund[]

  @@index([userId, status])
  @@index([orderId])
}

model PaymentWebhookEvent {
  id               String          @id @default(uuid())
  paymentAttemptId String
  paymentAttempt   PaymentAttempt  @relation(fields: [paymentAttemptId], references: [id])
  provider         PaymentProvider
  eventId          String          @unique
  payloadJson      String
  signatureValid   Boolean
  processed        Boolean         @default(false)
  processedAt      DateTime?
  createdAt        DateTime        @default(now())
}

model Refund {
  id               String         @id @default(uuid())
  paymentAttemptId String
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id])
  amountMinor      Int
  currency         String         @default("PKR")
  reason           String
  status           RefundStatus   @default(PENDING)
  providerRef      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Payout {
  id           String       @id @default(uuid())
  doctorUserId String
  doctor       User         @relation(fields: [doctorUserId], references: [id])
  amountMinor  Int
  currency     String       @default("PKR")
  status       PayoutStatus @default(PENDING)
  periodStart  DateTime
  periodEnd    DateTime
  providerRef  String?
  processedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([doctorUserId, status])
}
