generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                  @id @default(uuid())
  supabaseAuthUserId     String?                 @unique
  email                  String                  @unique
  mobile                 String?                 @unique
  passwordHash           String?
  role                   Role
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  auditLogs              AuditLog[]
  doctorProfile          DoctorProfile?
  reviewedVerifications  DoctorVerification[]    @relation("VerificationReviewer")
  patientProfile         PatientProfile?
  refreshTokens          RefreshToken[]
  deviceRegistrations    DeviceRegistration[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
}

model PatientProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  fullName          String
  dateOfBirth       DateTime?
  gender            String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  appointments      Appointment[]
  prescriptions     Prescription[]
  storedObjects     StoredObject[]
  cart              Cart[]
  deliveryAddresses DeliveryAddress[]
  pharmacyOrders    PharmacyOrder[]
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DoctorProfile {
  id             String               @id @default(uuid())
  userId         String               @unique
  fullName       String
  pmdcNumber     String               @unique
  specialty      String
  isVerified     Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  appointments   Appointment[]
  availabilities DoctorAvailability[]
  prescriptions  Prescription[]
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  verification   DoctorVerification?
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Specialty {
  id   String @id @default(uuid())
  name String @unique
}

model DoctorVerification {
  id              String             @id @default(uuid())
  doctorProfileId String             @unique
  status          VerificationStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  documents       DoctorDocument[]
  doctorProfile   DoctorProfile      @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  reviewedBy      User?              @relation("VerificationReviewer", fields: [reviewedById], references: [id])
}

model DoctorDocument {
  id                   String             @id @default(uuid())
  doctorVerificationId String
  type                 DocumentType
  storageKey           String
  uploadedAt           DateTime           @default(now())
  doctorVerification   DoctorVerification @relation(fields: [doctorVerificationId], references: [id], onDelete: Cascade)

  @@index([doctorVerificationId])
}

model DoctorAvailability {
  id                  String        @id @default(uuid())
  doctorProfileId     String
  dayOfWeek           Int
  startMinutes        Int
  endMinutes          Int
  slotDurationMinutes Int
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  doctorProfile       DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@index([doctorProfileId, dayOfWeek])
}

model Appointment {
  id               String            @id @default(uuid())
  patientProfileId String
  doctorProfileId  String
  slotStart        DateTime
  slotEnd          DateTime
  status           AppointmentStatus @default(PENDING)
  consultationType ConsultationType
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  doctorProfile    DoctorProfile     @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  patientProfile   PatientProfile    @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  prescriptions    Prescription[]

  @@unique([doctorProfileId, slotStart])
  @@index([patientProfileId])
  @@index([doctorProfileId])
}

model Prescription {
  id               String             @id @default(uuid())
  appointmentId    String
  doctorProfileId  String
  patientProfileId String
  status           PrescriptionStatus @default(ISSUED)
  version          Int                @default(1)
  supersedesId     String?
  medicines        Json
  instructions     String?
  voidedAt         DateTime?
  voidReason       String?
  issuedAt         DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  appointment    Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  doctorProfile  DoctorProfile   @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  patientProfile PatientProfile  @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  supersedes     Prescription?   @relation("PrescriptionRevisions", fields: [supersedesId], references: [id], onDelete: Restrict)
  revisions      Prescription[]  @relation("PrescriptionRevisions")
  pharmacyOrders PharmacyOrder[]

  @@unique([appointmentId, version])
  @@index([patientProfileId])
  @@index([doctorProfileId])
  @@index([appointmentId])
}

model StoredObject {
  id              String            @id @default(uuid())
  ownerId         String
  patientId       String?
  bucket          String
  objectPath      String
  mimeType        String
  sizeBytes       Int
  purpose         StoragePurpose    @default(MEDICAL_RECORD)
  scanStatus      StorageScanStatus @default(PENDING)
  isAvailable     Boolean           @default(false)
  uploadExpiresAt DateTime
  confirmedAt     DateTime?
  validatedAt     DateTime?
  rejectionReason String?
  sha256          String?
  createdAt       DateTime          @default(now())
  deletedAt       DateTime?

  patientProfile PatientProfile? @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([bucket, objectPath])
  @@index([ownerId])
  @@index([patientId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  actorUser   User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([targetType, targetId])
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  PMDC_CERT
  CNIC
  DEGREE
}

enum AppointmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  RESCHEDULE_PROPOSED
  CONFIRMED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ConsultationType {
  VIDEO
  AUDIO
  CHAT
}

enum PrescriptionStatus {
  ISSUED
  SUPERSEDED
  VOIDED
}

enum StorageScanStatus {
  PENDING
  VALIDATING
  PASSED
  REJECTED
  QUARANTINED
  ERROR
}

enum StoragePurpose {
  MEDICAL_RECORD
  LAB_RESULT
  IMAGING
  PRESCRIPTION_ATTACHMENT
  OTHER
}

model DeviceRegistration {
  id             String                 @id @default(uuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId String
  fcmToken       String                 @unique
  platform       DevicePlatform
  appMode        AppMode
  appVersion     String
  enabled        Boolean                @default(true)
  lastSeenAt     DateTime               @default(now())
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  revokedAt      DateTime?
  deliveries     NotificationDelivery[]

  @@unique([userId, installationId, appMode])
}

model Notification {
  id         String                 @id @default(uuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  titleKey   String
  bodyKey    String
  entityType String?
  entityId   String?
  route      String?
  dataJson   String?
  status     NotificationStatus     @default(QUEUED)
  createdAt  DateTime               @default(now())
  sentAt     DateTime?
  deliveries NotificationDelivery[]
}

model NotificationDelivery {
  id                   String             @id @default(uuid())
  notificationId       String
  notification         Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deviceRegistrationId String
  deviceRegistration   DeviceRegistration @relation(fields: [deviceRegistrationId], references: [id], onDelete: Cascade)
  providerMessageId    String?
  status               DeliveryStatus     @default(QUEUED)
  attemptCount         Int                @default(0)
  lastErrorCode        String?
  nextAttemptAt        DateTime?
  sentAt               DateTime?
  createdAt            DateTime           @default(now())
}

model NotificationPreference {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentUpdates  Boolean  @default(true)
  reminders           Boolean  @default(true)
  prescriptionUpdates Boolean  @default(true)
  pharmacyUpdates     Boolean  @default(true)
  paymentUpdates      Boolean  @default(true)
  marketing           Boolean  @default(false)
  quietHoursStart     Int?
  quietHoursEnd       Int?
  timezone            String   @default("Asia/Karachi")
  updatedAt           DateTime @updatedAt
}

model OutboxEvent {
  id            String       @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payloadJson   String
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
}

enum AppMode {
  PATIENT
  DOCTOR
  ADMIN
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_ACCEPTED
  APPOINTMENT_REJECTED
  APPOINTMENT_CANCELLED
  CONSULTATION_REMINDER
  CONSULTATION_STARTED
  PRESCRIPTION_ISSUED
  PRESCRIPTION_VOIDED
  MEDICAL_RECORD_VALIDATED
  MEDICAL_RECORD_REJECTED
  PHARMACY_ORDER_PLACED
  PHARMACY_ORDER_STATUS_CHANGED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  WALLET_CREDITED
  WALLET_DEBITED
  FOLLOW_UP_MESSAGE
}

enum NotificationStatus {
  QUEUED
  SENT
  PARTIAL
  FAILED
}

enum DeliveryStatus {
  QUEUED
  SENDING
  ACCEPTED_BY_PROVIDER
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

model PharmacyCategory {
  id          String            @id @default(uuid())
  name        String            @unique
  slug        String            @unique
  description String?
  imageUrl    String?
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    PharmacyProduct[]
}

model PharmacyProduct {
  id                   String                 @id @default(uuid())
  categoryId           String
  category             PharmacyCategory       @relation(fields: [categoryId], references: [id])
  sku                  String                 @unique
  genericName          String
  brandName            String
  strength             String?
  dosageForm           String
  manufacturer         String?
  packSize             Int                    @default(1)
  prescriptionRequired Boolean                @default(false)
  unitPriceMinor       Int
  currency             String                 @default("PKR")
  description          String?
  imageUrl             String?
  searchText           String
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  inventory            ProductInventory?
  cartItems            CartItem[]
  orderItems           PharmacyOrderItem[]
  reservations         InventoryReservation[]
}

model ProductInventory {
  id               String          @id @default(uuid())
  productId        String          @unique
  product          PharmacyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOnHand   Int             @default(0)
  quantityReserved Int             @default(0)
  reorderLevel     Int             @default(10)
  updatedAt        DateTime        @updatedAt
}

model Cart {
  id        String         @id @default(uuid())
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  currency  String         @default("PKR")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     CartItem[]

  @@unique([patientId, currency])
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   PharmacyProduct @relation(fields: [productId], references: [id])
  quantity  Int
  addedAt   DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId])
}

model DeliveryAddress {
  id            String          @id @default(uuid())
  patientId     String
  patient       PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  label         String
  recipientName String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  province      String
  postalCode    String?
  isDefault     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  orders        PharmacyOrder[]
}

model PharmacyOrder {
  id                String                 @id @default(uuid())
  orderNumber       String                 @unique
  patientId         String
  patient           PatientProfile         @relation(fields: [patientId], references: [id])
  deliveryAddressId String
  deliveryAddress   DeliveryAddress        @relation(fields: [deliveryAddressId], references: [id])
  prescriptionId    String?
  prescription      Prescription?          @relation(fields: [prescriptionId], references: [id])
  status            PharmacyOrderStatus    @default(PENDING_PAYMENT)
  subtotalMinor     Int
  deliveryFeeMinor  Int                    @default(0)
  discountMinor     Int                    @default(0)
  totalMinor        Int
  currency          String                 @default("PKR")
  idempotencyKey    String                 @unique
  recipientNameSnap String
  addressSnap       String
  citySnap          String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  items             PharmacyOrderItem[]
  statusHistory     OrderStatusHistory[]
  reservations      InventoryReservation[]
}

model PharmacyOrderItem {
  id              String          @id @default(uuid())
  orderId         String
  order           PharmacyOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         PharmacyProduct @relation(fields: [productId], references: [id])
  skuSnap         String
  productNameSnap String
  unitPriceSnap   Int
  quantity        Int
  lineTotalMinor  Int
  createdAt       DateTime        @default(now())
}

model InventoryReservation {
  id         String            @id @default(uuid())
  orderId    String
  order      PharmacyOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    PharmacyProduct   @relation(fields: [productId], references: [id])
  quantity   Int
  status     ReservationStatus @default(HELD)
  expiresAt  DateTime
  releasedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime          @default(now())
}

model OrderStatusHistory {
  id         String               @id @default(uuid())
  orderId    String
  order      PharmacyOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus PharmacyOrderStatus?
  toStatus   PharmacyOrderStatus
  changedBy  String?
  note       String?
  createdAt  DateTime             @default(now())
}

enum PharmacyOrderStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  CONFIRMED
  PREPARING
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  PAYMENT_FAILED
}

enum ReservationStatus {
  HELD
  CONSUMED
  RELEASED
  EXPIRED
}
